# If true, requests are allowed if Redis is down. If false, returns a 503 error.
RATE_LIMITER_FAIL_OPEN=True

# Database
# Database (async driver — used by FastAPI)
DATABASE_URL=postgresql+asyncpg://vault:vault@db:5432/researchvault

# Database (sync driver — used by Celery tasks and Alembic)
DATABASE_URL_SYNC=postgresql://vault:vault@db:5432/researchvault

POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=researchvault

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# SearXNG
SEARXNG_URL=http://searxng:8080

# JWT
JWT_SECRET=changeme-replace-with-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------- AI providers (Optional - they can be empty) -------------

# OpenRouter (Requires a key starting with "sk-or-v1-...")
OPENROUTER_API_KEY=

# Hugging Face (Requires a key starting with "hf_...")
HF_API_KEY=

# Groq (Requires a key starting with "gsk_...")
GROQ_API_KEY=

# Gemini / Google AI Studio (Requires a key starting with "AIzaSy...")
GEMINI_API_KEY=

# ------------- --------------------------------------------- -------------

# Roadmap caching & AI/Auth endpoint rate limiting (Redis, fixed window)
ROADMAP_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# App
APP_ENV=development