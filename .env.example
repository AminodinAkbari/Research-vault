# Database
# Database (async driver — used by FastAPI)
DATABASE_URL=postgresql+asyncpg://vault:vault@db:5432/researchvault

# Database (sync driver — used by Celery tasks and Alembic)
DATABASE_URL_SYNC=postgresql://vault:vault@db:5432/researchvault

POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=researchvault

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# SearXNG
SEARXNG_URL=http://searxng:8080

# JWT
JWT_SECRET=changeme-replace-with-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI credentionals - huggingface (OpenAI-compatible API)
AI_API_KEY=<Paste you api key here>
AI_BASE_URL=https://api-inference.huggingface.co/v1
AI_MODEL=deepseek-ai/DeepSeek-V3-0324

# If deepseek v3 frequently return 503 , we ca switch to these models (replace the above AI_MODEL with one of these) :
# meta-llama/Llama-3.2-3B-Instruct
# Qwen/Qwen2.5-72B-Instruct
# mistralai/Mixtral-8x7B-Instruct-v0.1 

# Roadmap caching & rate limiting
ROADMAP_CACHE_TTL_SECONDS=3600
ROADMAP_RATE_LIMIT_MAX_REQUESTS=5
ROADMAP_RATE_LIMIT_WINDOW_SECONDS=60

# App
APP_ENV=development